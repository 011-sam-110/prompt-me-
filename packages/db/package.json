{
  "name": "@prompt-me/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Drizzle ORM schema and query layer for Postgres/Neon (ENGINEERING_SPEC.md §1, §2).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "default": "./src/schema/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "@neondatabase/serverless": "^1.1.0",
    "@electric-sql/pglite": "^0.5.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "@prompt-me/core": "0.0.0"
  }
}

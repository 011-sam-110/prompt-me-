# Copy to .env and fill in what you have. Every integration below sits
# behind an adapter with a dev-mock fallback (CLAUDE.md, ENGINEERING_SPEC.md
# §1) — nothing here is required to typecheck/lint/test/build the app.
# See ROADMAP.md -> "Needs from Sampo" for which milestone first needs each one.

# packages/db (M1). A Neon Postgres connection string. Without it,
# getDb() throws only when actually called — schema/tests use an
# in-memory PGlite instance instead (packages/db/src/schema/schema.test.ts).
DATABASE_URL=

# Clerk (M2) — session/account management only. Without both of these,
# apps/web automatically falls back to a dev-mode auth stub (see
# apps/web/src/lib/auth) — sign-up/sign-in, the users-row creation, and
# the onboarding gate all work with zero real credentials.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Signing secret for the Clerk webhook (apps/web/src/app/api/webhooks/clerk)
# that creates a users row on `user.created`. Only needed once Clerk is
# actually configured above — the dev-mode server-action path creates the
# same row without it.
CLERK_WEBHOOK_SECRET=

# Didit (M3) — facial age estimation + liveness/face-match.
DIDIT_API_KEY=

# OpenAI (M4, M12) — Whisper transcription + omni-moderation-latest.
OPENAI_API_KEY=

# Anthropic (M10) — date-idea generation from clip transcripts.
ANTHROPIC_API_KEY=

# Google Places (M9) — venue-restricted meeting-place picker.
GOOGLE_PLACES_API_KEY=

# Pusher Channels (M11) — realtime pre-date chat window.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# Resend (M13) — transactional email notifications.
RESEND_API_KEY=

# Vercel Blob (§4) — clip video/audio storage.
BLOB_READ_WRITE_TOKEN=

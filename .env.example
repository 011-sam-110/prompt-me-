# Copy to .env and fill in what you have. Every integration below sits
# behind an adapter with a dev-mock fallback (CLAUDE.md, ENGINEERING_SPEC.md
# §1) — nothing here is required to typecheck/lint/test/build the app.
# See ROADMAP.md -> "Needs from Sampo" for which milestone first needs each one.

# packages/db (M1). A Neon Postgres connection string. Without it,
# getDb() throws only when actually called — schema/tests use an
# in-memory PGlite instance instead (packages/db/src/schema/schema.test.ts).
DATABASE_URL=

# Clerk (M2) — session/account management only. Without both of these,
# apps/web automatically falls back to a dev-mode auth stub (see
# apps/web/src/lib/auth) — sign-up/sign-in, the users-row creation, and
# the onboarding gate all work with zero real credentials.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Signing secret for the Clerk webhook (apps/web/src/app/api/webhooks/clerk)
# that creates a users row on `user.created`. Only needed once Clerk is
# actually configured above — the dev-mode server-action path creates the
# same row without it.
CLERK_WEBHOOK_SECRET=

# Didit (M3) — facial age estimation + liveness/face-match. Without this,
# apps/web automatically falls back to a deterministic dev-mock verification
# provider (packages/core/src/verification) that always passes — the
# onboarding flow is fully clickable with zero real credentials.
DIDIT_API_KEY=
# Optional override of Didit's API base URL (e.g. a self-hosted proxy).
# Defaults to packages/core/src/verification/didit-provider.ts's production
# endpoint if unset.
DIDIT_API_BASE_URL=

# OpenAI (M4, M12) — Whisper transcription + omni-moderation-latest.
OPENAI_API_KEY=
# Optional override of OpenAI's API base URL (e.g. a self-hosted proxy).
# Defaults to packages/core/src/moderation/omni-moderation-provider.ts's
# production endpoint if unset.
OPENAI_API_BASE_URL=

# M12's internal moderation review queue (/internal/moderation) — a
# comma-separated allowlist of Clerk user ids permitted to open it.
# apps/web/src/lib/moderation/reviewer-access.ts's own comment explains
# why: no staff/reviewer role exists anywhere in this schema yet, so
# leaving this unset (today's default) falls back to "any signed-in user
# may open it" rather than blocking the milestone on a role system that
# doesn't exist. Set once real reviewer accounts do.
INTERNAL_REVIEWER_CLERK_IDS=

# Anthropic (M10) — date-idea generation from clip transcripts. Without
# this, apps/web automatically falls back to a deterministic dev-mock
# generator (packages/core/src/date-ideas) that returns two clearly-fake
# [DEV MOCK]-prefixed placeholder ideas — the planning page's generated-ideas
# panel is fully clickable with zero real credentials.
ANTHROPIC_API_KEY=

# Google Places (M9) — venue-restricted meeting-place picker.
GOOGLE_PLACES_API_KEY=

# Pusher Channels (M11) — realtime pre-date chat window. Without all four
# of these, apps/web automatically falls back to an in-memory dev-mock
# pub/sub (packages/core/src/realtime) — an SSE route stands in for the
# browser's long-lived Pusher socket, so the chat window is fully
# clickable, with live delivery between two open tabs, with zero real
# credentials.
PUSHER_APP_ID=
PUSHER_SECRET=
# PUSHER_KEY/PUSHER_CLUSTER are NOT secret in Pusher's own model (only
# appId/secret are) — NEXT_PUBLIC_PUSHER_KEY/NEXT_PUBLIC_PUSHER_CLUSTER
# below mirror them into the client bundle, which needs its own Pusher
# instance to subscribe (this is exactly what "Vercel functions can't hold
# long-lived sockets" in ENGINEERING_SPEC.md §1 means: the server can only
# trigger an event, not hold the browser's connection open itself).
PUSHER_KEY=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# Resend (M13) — transactional email notifications.
RESEND_API_KEY=

# Vercel Blob (§4) — clip video/audio storage.
BLOB_READ_WRITE_TOKEN=
